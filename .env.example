DATABASE_URI=postgresql://localhost:5432/motoknife
PAYLOAD_SECRET=your-secret-here
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Resend (Email service for contact form)
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_EMAIL=service@motoknife.com

# Media 上傳目錄（實體檔案存放位置）
# 集中存放於 NAS 共享資料夾時設定；未設定則用專案內 media/（本機模式）。
# 程式內經 path.resolve 正規化，Windows 反斜線可直接寫。
#   Windows 掛載網路磁碟機： MEDIA_DIR=M:\
#   Mac SMB 掛載：           MEDIA_DIR=/Volumes/motoknife-media
#   未設定（本機模式）：      使用專案內 media/
# MEDIA_DIR=M:\
